# Copy to .env and fill in. .env is git-ignored.

# Sent in the User-Agent so Melee can reach you if a request pattern ever bothers them.
MELEE_CONTACT_EMAIL=you@example.com

# Seconds between Melee requests (minimum 2.0 enforced in code).
MELEE_REQUEST_INTERVAL=2.5

# Optional: TopDeck.gg API key (free from their developer portal).
TOPDECK_API_KEY=

# Optional, for `python scripts/sync_local.py` (refresh data/silver and data/gold from R2).
# rclone reads a remote named "r2" from these; or run `rclone config` instead and leave them out.
# Use a token scoped to read-only access on the bucket. Never commit the filled-in .env.
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# RCLONE_REMOTE=r2
# R2_BUCKET=mtgmeta-bronze
