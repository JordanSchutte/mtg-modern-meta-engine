# Copy to .env and fill in. .env is git-ignored.

# Sent in the User-Agent so Melee can reach you if a request pattern ever bothers them.
MELEE_CONTACT_EMAIL=you@example.com

# Seconds between Melee requests (minimum 2.0 enforced in code).
MELEE_REQUEST_INTERVAL=2.5

# Optional: TopDeck.gg API key (free from their developer portal).
TOPDECK_API_KEY=
